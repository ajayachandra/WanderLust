<% layout("/layouts/boilerplate.ejs") %>
<style>
 
#filters {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 1.5rem;
  padding: 1rem 0;
}

.filter {
  text-align: center;
  min-width: 65px;
  opacity: 0.7;
  cursor: pointer;
  flex-shrink: 0;
  margin-top: 0.6rem;
  color: inherit;
  text-decoration: none;
  display: block;
}

.filter:hover {
  opacity: 1;
}

.filter i {
  font-size: 1.2rem;
}

.filter p {
  font-size: 0.8rem;
  margin: 0.3rem 0 0 0;
}

.tax-toggle {
  margin-left: auto;
  display: flex;
  align-items: center;
  white-space: nowrap;
}

.tax-info{
  display: none;
}

.tax-toggle{
  border: 1.4px solid black;
  border-radius: 1rem;
  height: 3rem;
  padding: 1rem;
}

@media (max-width: 768px) {
  #filters {
    gap: 1rem;
  }

  .tax-toggle {
    margin-left: 0;
    width: 100%;
    justify-content: flex-start;
  }
}


@media (max-width: 480px) {
  #filters {
    gap: 1rem 0.75rem;
    justify-content: space-between;
  }

  .filter {
    min-width: 60px;
    flex: 1 0 60px;
  }

  .filter p {
    font-size: 0.7rem;
  }

  .tax-toggle {
    font-size: 0.85rem;
    white-space: normal;
  }
}

</style>

<body>
<div id="filters">
  <a class="filter" href="/listings?category=Trending">
      <div><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p>
  </a>
  <a class="filter" href="/listings?category=Rooms">
      <div><i class="fa-solid fa-bed"></i></div>
      <p>Rooms</p>
  </a>
  <a class="filter" href="/listings?category=Iconic Cities">
      <div><i class="fa-solid fa-mountain-city"></i></div>
      <p>Iconic Cities</p>
  </a>
  <a class="filter" href="/listings?category=Castles">
      <div><i class="fa-brands fa-fort-awesome"></i></div>
      <p>Castles</p>
  </a>
  <a class="filter" href="/listings?category=Mountains">
      <div><i class="fa-solid fa-mountain"></i></div>
      <p>Mountains</p>
  </a>
  <a class="filter" href="/listings?category=Amazing Pools">
      <div><i class="fa-solid fa-person-swimming"></i></div>
      <p>Amazing Pools</p>
  </a>
  <a class="filter" href="/listings?category=Camping">
      <div><i class="fa-solid fa-campground"></i></div>
      <p>Camping</p>
  </a>
  <a class="filter" href="/listings?category=Farms">
      <div><i class="fa-solid fa-cow"></i></div>
      <p>Farms</p>
  </a>
  <a class="filter" href="/listings?category=Arctic">
      <div><i class="fa-solid fa-snowflake"></i></div>
      <p>Arctic</p>
  </a>
  <a class="filter" href="/listings?category=Domes">
      <div><i class="fa-solid fa-landmark-dome"></i></div>
      <p>Domes</p>
  </a>
  <a class="filter" href="/listings?category=Boats">
      <div><i class="fa-solid fa-sailboat"></i></div>
      <p>Boats</p>
  </a>

  <div class="tax-toggle">
      <div class="form-check-reverse form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="switchMdLabel" >
        <label class="form-check-label" for="switchMdLabel"> Display total after taxes</label>
      </div>
  </div>
      
  </div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-2">
  <% for(let listing of allListings){%>
    <a href="/listings/<%=listing._id%>" class="listing-link">
       <div class="card listing-card">
         <img src="<%=listing.image.url%>" class="card-img-top" alt="..." style="height: 20rem;">
           <div class="card-img-overlay"></div>
           <div class="card-body">
              <p class="card-text">
                <b><%= listing.title%><br></b>
                &#8377;<%=listing.price.toLocaleString("en-IN")%>/night
                <i class="tax-info"> &nbsp; &nbsp; +18% GST </i>
              </p>  
           </div>
           
        </div>
        </a>
    <%}%> 
</div>
</body>

<script>
  let taxSwitch = document.getElementById("switchMdLabel");
  taxSwitch.addEventListener("click",()=>{
    let taxInfo = document.getElementsByClassName("tax-info");
    for(let info of taxInfo){
      if(info.style.display != "inline"){
          info.style.display="inline";
      }else{
        info.style.display="none";
      }
      
    }
  });
</script>